# Tạo 2 file ở thư mục gốc repo: .env.dev và .env.prod (đã bị gitignore bởi .env*).
# Mỗi file có cùng các biến dưới đây, chỉ khác giá trị. KHÔNG commit file chứa giá trị thật.
# Script chỉ đọc đúng file được chọn bằng --env=dev / --env=prod (không đọc .env hay .env.local).

# Chuỗi kết nối Postgres của Supabase (Project Settings -> Database -> Connection string).
# Pooler (port 6543) hoặc direct (5432) đều được.
DATABASE_URL=

# Schema cần ghi: dev_multi_lang cho dev, prod hoặc prod_v2 cho production.
DB_SCHEMA=

# Chỉ cần cho bước vi:translate (có thể chỉ để trong .env.dev).
ANTHROPIC_API_KEY=

# (tuỳ chọn) Model dịch. Mặc định claude-sonnet-5-5.
# VI_MODEL=

# (tuỳ chọn) Sau khi ghi DB, script tự gọi URL này để làm mới cache. Ví dụ:
# REVALIDATE_URL=https://your-domain.com/api/revalidate-all
REVALIDATE_URL=
