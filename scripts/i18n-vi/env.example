# Copy các dòng này vào .env.local (đã bị gitignore) rồi điền giá trị.
# KHÔNG commit file chứa giá trị thật.

# Chuỗi kết nối Postgres của Supabase (Project Settings -> Database -> Connection string).
# Dùng pooler (port 6543) hoặc direct (5432) đều được.
DATABASE_URL=

# Schema cần ghi: dev_multi_lang cho dev/staging, prod hoặc prod_v2 cho production.
# Có thể truyền ngay trên dòng lệnh: DB_SCHEMA=prod npm run vi:check
DB_SCHEMA=

# Chỉ cần cho bước vi:translate (gọi Claude API để dịch).
ANTHROPIC_API_KEY=

# (tuỳ chọn) Model dịch. Mặc định claude-sonnet-5-5.
# VI_MODEL=

# (tuỳ chọn) Sau khi ghi DB, script tự gọi URL này để làm mới cache. Ví dụ:
# REVALIDATE_URL=https://your-domain.com/api/revalidate-all
REVALIDATE_URL=
